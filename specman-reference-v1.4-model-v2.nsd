// {"specmanVersion":"1.4.0","modelType":"specman.model.v002.DiagramModel_V002"}
// Specman: frame0
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(...) { [base64:...] } blocks: embedded binary image data (base64-encoded)

settings {
    width=840
    zoom=120
    changeModeEnabled=true
    changeSetName=yellow
    metaTags {
        tag(`user`, background=#ffcccc, border=#ff0033, label=`User`, icon=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
  <circle cx="12" cy="7" r="4" fill="#8B0000"/>
  <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" fill="#8B0000"/>
</svg>
`)
        tag(`no_freetext`, background=#e0e0e0, label=`No freetext - No border`, icon=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
  <circle cx="12" cy="7" r="4" fill="#8B0000"/>
  <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" fill="#8B0000"/>
</svg>
`, freetext=false)
        tag(`icon_only`, background=#e0e0e0, icon=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
  <circle cx="12" cy="7" r="4" fill="#8B0000"/>
  <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" fill="#8B0000"/>
</svg>
`)
        tag(`transparent_background`, background=#e0e0e000, icon=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
  <circle cx="12" cy="7" r="4" fill="#8B0000"/>
  <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" fill="#8B0000"/>
</svg>
`)
        tag(`label_only`, background=#ccccff, border=#0000ff, label=`Label only`)
    }
}

intro(`<h1>
      Specman Reference
    </h1>
    <div>
      This model includes all modelling elements supported by Specman, mainly 
      to derive a JSON schema from it.
    </div>
    <div>
      This section is the intro of a usecase.
    </div>`, plain=`Specman Reference
This model includes all modelling elements supported by Specman, mainly to derive a JSON schema from it.
This section is the intro of a usecase.`) {
}

mainSequence {
    simple(1, 5582897d, `Simple step. Every step has an ID which is automatically modified when the 
    step changes its position within the step sequence. The IDs always make up 
    a gapless number sequence. Specman immediately renumbers steps when they 
    are moved or steps are inserted before.`, plain=`Simple step. Every step has an ID which is automatically modified when the step changes its position within the step sequence. The IDs always make up a gapless number sequence. Specman immediately renumbers steps when they are moved or steps are inserted before.`);
    while(2, e81623e9, `While loop`, plain=`While loop`, barWidth=21) {
        simple(2.1, a6c0af76, `Steps being run with every repetition of the loop.`, plain=`Steps being run with every repetition of the loop.`);
    }
    doWhile(3, 03571bad, `While while loop. There is no sementical difference to the while loop. Its 
    more a matter of preference, if things become clearer by the extra bottom 
    bar.`, plain=`While while loop. There is no sementical difference to the while loop. Its more a matter of preference, if things become clearer by the extra bottom bar.`, barWidth=21) {
        simple(3.1, 1f9f7579, `Steps being run with every repetition of the loop.`, plain=`Steps being run with every repetition of the loop.`);
    }
    simple(4, 5bfae252, `As step refering to another step by its number 1. The reference number is 
    automatically updated, when the refered step changes its number.`, plain=`As step refering to another step by its number 1. The reference number is automatically updated, when the refered step changes its number.`, markups=[(47,47,Steplink)]);
    source(5, 29735b11, `<strike><font color="#c0c0c0" size="1">.</font></strike>`, plain=`.`, markups=[(0,0,Changed,orange)], orange, sourceStep=7505df4a);
    simple(6, e0dc4407, `A step being added in the yellow change set. Step reference to step 2.`, plain=`A step being added in the yellow change set. Step reference to step 2.`, markups=[(0,67,Changed,yellow)(68,68,ChangedSteplink,yellow)(69,69,Changed,yellow)], change=(added, yellow));
    simple(7, 77aedb1e, `A step with text being added and <strike>text being deleted </strike>in 
    the yellow change set.`, plain=`A step with text being added and text being deleted in the yellow change set.`, markups=[(12,32,Changed,yellow)(33,51,Changed,yellow)(52,75,Changed,yellow)]);
    simple(8, 4c4e2d58, `This step has been removed in the blue changeset`, plain=`This step has been removed in the blue changeset`, change=(removed, blue));
    simple(9, 97ba3cc4, `<div>
      Available change sets are:
    </div>`, plain=`Available change sets are:`) {
        list(ordered=false) {
            item(`yellow`, plain=`yellow`, markups=[(0,5,Changed,yellow)], change=(added, yellow))
            item(`lilac`, plain=`lilac`, markups=[(0,4,Changed,lilac)], change=(added, yellow))
            item(`blue`, plain=`blue`, markups=[(0,3,Changed,blue)], change=(added, yellow))
            item(`orange`, plain=`orange`, markups=[(0,5,Changed,orange)], change=(added, yellow))
            item(`pink`, plain=`pink`, markups=[(0,3,Changed,pink)], change=(added, yellow))
        }
        text(`Trailing text from yellow change set`, plain=`Trailing text from yellow change set`, markups=[(0,35,Changed,yellow)])
    }
    break(10, 6131450e, `<b>Exception 1 - should have single line text</b>`, plain=`Exception 1 - should have single line text`);
    ifElse(11, 1297a277, `<div align="center">
      If-Else-Step. The field in here contains the condition to check for. 
      Might by expressed as a question.
    </div>`, plain=`If-Else-Step. The field in here contains the condition to check for. Might by expressed as a question.`, ifRatio=50.00%) {
        if_branch(`Heading of the Yes-Sequence, of the question can be answered by &quot;yes&quot; or 
    &quot;no&quot;. However, it is recommended not to work with Yes-No-Questions.`, plain=`Heading of the Yes-Sequence, of the question can be answered by "yes" or "no". However, it is recommended not to work with Yes-No-Questions.`) {
            simple(11.1, 669b351f, `Steps being run in the Yes-Case`, plain=`Steps being run in the Yes-Case`);
        }
        else_branch(`<div align="right">
      Heading of the No-Sequence
    </div>`, plain=`Heading of the No-Sequence`) {
            simple(12.1, 55cfd53b, `Steps to be run in the No-Case`, plain=`Steps to be run in the No-Case`);
        }
    }
    ifElse(13, 1e278bd4, `<div align="center">
      If-else step with a modified width ratio of its branches. This is 
      supported for if and case steps as well.
    </div>`, plain=`If-else step with a modified width ratio of its branches. This is supported for if and case steps as well.`, ifRatio=13.32%) {
        if_branch(`Small width branch`, plain=`Small width branch`) {
            simple(13.1, a11bbefb, ``, plain=``);
        }
        else_branch(`<div align="right">
      Big width branch
    </div>`, plain=`Big width branch`) {
            simple(14.1, a9ca3151, ``, plain=``);
        }
    }
    break(15, 79866663, `<b>Exception 2</b>`, plain=`Exception 2`, tags=[(`transparent_background`)]);
    if(16, ff611d0d, `<div align="center">
      If-Step as a special form of an If-Else-Step which simply has no 
      No-Sequence
    </div>`, plain=`If-Step as a special form of an If-Else-Step which simply has no No-Sequence`, emptyWidth=24) {
        if_branch(`<div align="right">
      Heading of the Yes-Sequence
    </div>`, plain=`Heading of the Yes-Sequence`) {
            simple(16.1, fbeccd87, `Steps being run in the Yes-Case`, plain=`Steps being run in the Yes-Case`);
        }
    }
    break(17, 62d122eb, `<b>Exception 3</b>`, plain=`Exception 3`);
    case(18, b3fea8cf, `Switch-Case-Step. At least the Else-Sequence and two other cases are 
    mandatory. Otherwise use If-Else or If.`, plain=`Switch-Case-Step. At least the Else-Sequence and two other cases are mandatory. Otherwise use If-Else or If.`, cols=[33.17%, 33.17%, 33.17%]) {
        default_branch(`Heading of the Else-Sequence`, plain=`Heading of the Else-Sequence`) {
            simple(18.1, 2feefd1f, `Steps being run in the Else-Case`, plain=`Steps being run in the Else-Case`);
        }
        case_branch(`Heading if the Case 1 sequence`, plain=`Heading if the Case 1 sequence`) {
            simple(19.1, 4b4d5748, `Steps being run in case 1`, plain=`Steps being run in case 1`);
        }
        case_branch(`Heading if the Case 2 sequence`, plain=`Heading if the Case 2 sequence`) {
            simple(20.1, 46e11496, `Steps being run in case 2`, plain=`Steps being run in case 2`);
        }
    }
    subsequence(21, f346092d, `<b>Subsequence</b>`, plain=`Subsequence`) {
        simple(21.1, 937834b6, `Steps being run in this subsequence`, plain=`Steps being run in this subsequence`);
    }
    break(22, 7b1d7dda, `<b>Exception 4 - no catch - this is allowed</b>`, plain=`Exception 4 - no catch - this is allowed`);
    simple(23, 7505df4a, `<div>
      Step moved in orange change set. Empty source step appears with orange 
      background and step number with black background, showing both, the 
      source step number itself, followed by the number where the step has 
      been moved to.
    </div>
    <div>
      The moved step appears with white background and an orange step number 
      including the source step number.
    </div>`, plain=`Step moved in orange change set. Empty source step appears with orange background and step number with black background, showing both, the source step number itself, followed by the number where the step has been moved to.
The moved step appears with white background and an orange step number including the source step number.`, change=(target, orange, sourceStep=29735b11));
    simple(24, b5f52c59, `<div>
      This step illustrates complex formatting. In general, text size and 
      weight is expressed by HTML formatting like
    </div>
    <div>
      <b>bold</b>
    </div>
    <div>
      <i>italic</i>
    </div>
    <div>
      <u>underlined</u>
    </div>
    <div>
      
    </div>
    <div>
      Lists are not expressed by HTML but by appropriate edit areas like that 
      for unordered lists:
    </div>`, plain=`This step illustrates complex formatting. In general, text size and weight is expressed by HTML formatting like
bold
italic
underlined

Lists are not expressed by HTML but by appropriate edit areas like that for unordered lists:`) {
        list(ordered=false) {
            item(`unordered list item 1`, plain=`unordered list item 1`)
            item(`unordered list item 2`, plain=`unordered list item 2`)
        }
        text(`<div>
      For ordered lists:
    </div>`, plain=`For ordered lists:`)
        list(ordered=true) {
            item(`ordered list item 1`, plain=`ordered list item 1`)
            item(`ordered list item 2`, plain=`ordered list item 2`)
        }
        text(`Lists cannot be nested`, plain=`Lists cannot be nested`)
    }
    simple(25, 90434779, `<div>
      As for list items, also tables are not expressed by HTML but by special 
      edit areas like this. However, the first edit area in every edit 
      container must be a text edit area, even if it is empty!
    </div>`, plain=`As for list items, also tables are not expressed by HTML but by special edit areas like this. However, the first edit area in every edit container must be a text edit area, even if it is empty!`) {
        table(width=100%) {
            row { cell(`<b>Spalte 1</b>`, plain=`Spalte 1`) | cell(`<b>Spalte 2</b>`, plain=`Spalte 2`) | cell(`<b>Spalte 3</b>`, plain=`Spalte 3`) }
            row { cell(`You might place nested tables or list items in the cells of a table`, plain=`You might place nested tables or list items in the cells of a table`) | cell(`Zelle 2.1`, plain=`Zelle 2.1`) | cell(`Zelle 3.1`, plain=`Zelle 3.1`) }
        }
    }
    simple(26, 796e7722, `<div>
      Supported headings
    </div>
    <h1>
      Heading 1
    </h1>
    <h2>
      Heading 2
    </h2>
    <h3>
      Heading 3
    </h3>
    <h4>
      Heading 4
    </h4>
    <h5>
      Heading 5
    </h5>
    <h6>
      Heading 6
    </h6>`, plain=`Supported headings
Heading 1
Heading 2
Heading 3
Heading 4
Heading 5
Heading 6`);
    simple(27, de07e4fa, `<div>
      Supported font sizes
    </div>
    <div>
      <font size="1">xx-small</font>
    </div>
    <div>
      <font size="2">x-smal</font>
    </div>
    <div>
      <font size="3">small</font>
    </div>
    <div>
      <font size="4">middle (default)</font>
    </div>
    <div>
      <font size="5">big</font>
    </div>
    <div>
      <font size="6">x-big</font>
    </div>
    <div>
      <font size="7">xx-big</font>
    </div>`, plain=`Supported font sizes
xx-small
x-smal
small
middle (default)
big
x-big
xx-big`);
    simple(28, 8f91e946, `<div>
      Supported fonts are
    </div>
    <div>
      Sitka - Serif (default font)
    </div>
    <div>
      <font face="Roboto">Roboto - Sans Serif</font>
    </div>
    <div>
      <font face="CourierPrime">Courier - Monospace</font>
    </div>`, plain=`Supported fonts are
Sitka - Serif (default font)
Roboto - Sans Serif
Courier - Monospace`);
    simple(29, 776adb0b, `<div>
      Text might have a pre-formatted text section. Only preformatted text 
      keeps all its whitespaces while multiple whitespaces in other text 
      sections are eliminated when saving. Pre-formatted text is always 
      displayed in a monospaced font.
    </div>
    <pre>This<br>  text<br>    is<br>  pre  -  formatted<br></pre>`, plain=`Text might have a pre-formatted text section. Only preformatted text keeps all its whitespaces while multiple whitespaces in other text sections are eliminated when saving. Pre-formatted text is always displayed in a monospaced font.
This   text     is   pre  -  formatted `);
    simple(30, 24a10aa0, `Step with rounded border decoration.`, plain=`Step with rounded border decoration.`, deco=Full);
    simple(31, e7290917, `Following step with border decoration. There is no gap line displayed in a 
    sequence of steps with this decoration.`, plain=`Following step with border decoration. There is no gap line displayed in a sequence of steps with this decoration.`, deco=Co);
    subsequence(32, fde99ef2, `<b>Subsequence with special catch sequence</b>`, plain=`Subsequence with special catch sequence`, deco=Co) {
        simple(32.1, 15856508, `The catch area of the subsequence has a modified width ratio of its 
    branches, a modified righ bar width in the co-catch, and the catch area is 
    collapsed`, plain=`The catch area of the subsequence has a modified width ratio of its branches, a modified righ bar width in the co-catch, and the catch area is collapsed`);
        break(32.2, 074ad64c, `<b>Sub X1</b>`, plain=`Sub X1`);
        break(32.3, 77f1ab52, `<b>Sub X2</b>`, plain=`Sub X2`);
        break(32.4, 4f9e39ae, `<b>Sub X3</b>`, plain=`Sub X3`);
        catchArea(collapsed=true, cols=[20%, 79%]) {
            catch(32.2, `<b>Sub X1</b>`, plain=`Sub X1`, headingWidth=21) {
                simple(32.2.1, fe4d5e16, `Small width`, plain=`Small width`);
            }
            catch(32.3, `<b>Sub X2</b>`, plain=`Sub X2`, headingWidth=78) {
                coCatch(32.4, `<b>Sub X3</b>`, plain=`Sub X3`);
                simple(32.3.1, 142ae6b6, `Big width, big right bar width`, plain=`Big width, big right bar width`);
            }
        }
    }
    while(33, ee92204e, `Collapsed while loop. Each structured step allows to hide its sub sequences`, plain=`Collapsed while loop. Each structured step allows to hide its sub sequences`, barWidth=21, collapsed=true) {
        simple(33.1, 6320fb89, `Neuer Schritt 1`, plain=`Neuer Schritt 1`);
    }
    doWhile(34, dfce79d0, `Loop with shaded background`, plain=`Loop with shaded background`, barWidth=21, shade=#dcdcdc) {
        simple(34.1, 81ed3633, `Neuer Schritt 1`, plain=`Neuer Schritt 1`);
    }
    ifElse(35, 717e5669, `<div align="center">
      New if step with shading, resulting in a mixed background color
    </div>`, plain=`New if step with shading, resulting in a mixed background color`, markups=[(0,62,Changed,yellow)], ifRatio=50.00%, change=(added, yellow), shade=#dcdcdc) {
        if_branch(`Branch headings shaded too`, plain=`Branch headings shaded too`, markups=[(0,25,Changed,yellow)], change=(added, yellow)) {
            simple(35.1, afbac578, `Steps within the sequences not shaded`, plain=`Steps within the sequences not shaded`, markups=[(0,36,Changed,yellow)], change=(added, yellow));
        }
        else_branch(`<div align="right">
      Branch heading shaded too
    </div>`, plain=`Branch heading shaded too`, markups=[(0,24,Changed,yellow)], change=(added, yellow)) {
            simple(36.1, 27ce0689, ``, plain=``, change=(added, yellow));
        }
    }
    source(37, cf97c413, `<strike><font color="#c0c0c0" size="1">.</font></strike>`, plain=`.`, markups=[(0,0,Changed,yellow)], yellow, sourceStep=1a9866f8);
    simple(38, f9016c65, `Step with meta tags`, plain=`Step with meta tags`, tags=[(`user`, `Tag from a full-featured tag configuration, including
- SVG icon
- Label text, differing from tag configuration identifier
- Background color
- Border color
- Freetext allowed

The freetext is displayed as tooltip within the UI and is exported as a comment in PDF. Freetext does not support any formatting.

Editing the freetext is initiated either by a single click on the tag or by selecting "Edit" from the tag's context menu. The edit window is limited to 12 lines of text and is displayed with a scrollbar if it exceeds the limit. The tooltip size is unlimited.

The tag order can be changed by either pressing the left mouse button and dragging the tag or by selecting "Move right" or "Move left" from the tag's context menu`), (`no_freetext`), (`icon_only`, `A meta tag can be configured to have either an icon or a label or both.`), (`transparent_background`, `Background coloring supports transparency`), (`label_only`, `<html>
This will not be treated as HTML as freetext of tags is only unformatted <b>plain text</b>.
</html>`)]);
    while(39, 3e4ceb15, `Sub-structured step with meta tag, demonstrating the position of the fold 
    button`, plain=`Sub-structured step with meta tag, demonstrating the position of the fold button`, barWidth=21, tags=[(`user`, `The fold button of a structured step is always located left from the step's last meta tag. This is especially reasonable as the fold button is *not* permanently displayed while the step is unfolded, but only when the user hovers over its location.
Tags - just like the step number - will not change on folding the step.`)]) {
        simple(39.1, c2f1666d, ``, plain=``);
    }
    simple(40, d3b571df, `Deleted step with tags`, plain=`Deleted step with tags`, change=(removed, yellow), tags=[(`user`, `Tags of deleted steps are displayed with black background, grey (disabled) icon and grey border. They can no longer be edited nor moved nor deleted. Any freetext is still displayed as tooltip. `), (`icon_only`), (`label_only`)]);
    break(41, 220753bc, `<b>Tagged break</b>`, plain=`Tagged break`, tags=[(`user`, `Tags of break steps are not mirrored in the corresponding catch area's heading.`)]);
    simple(42, c01bc240, `Tagged step with border decoration and shading.`, plain=`Tagged step with border decoration and shading.`, deco=Full, shade=#dcdcdc, tags=[(`user`)]);
    simple(43, 1a9866f8, `Moved step with tags. The tags move to the target step together with 
    content. The source step does not keep them.`, plain=`Moved step with tags. The tags move to the target step together with content. The source step does not keep them.`, change=(target, yellow, sourceStep=cf97c413), tags=[(`user`)]);
    catchArea {
        catch(10, `<b>Exception 1 - should have single line text</b>`, plain=`Exception 1 - should have single line text`, headingWidth=21) {
            coCatch(17, `<b>Exception 3</b>`, plain=`Exception 3`);
            simple(10.1, 92dc561b, `Sequence for handling the exception in case it occured in break step 10 The 
    catch step has the same number as the break step. Catch sequences may 
    occur at the end of the sequence where the break step is in or at the end 
    of any sequence on a higher level.`, plain=`Sequence for handling the exception in case it occured in break step 10 The catch step has the same number as the break step. Catch sequences may occur at the end of the sequence where the break step is in or at the end of any sequence on a higher level.`, markups=[(69,70,Steplink)]);
            simple(10.2, 8471a0ea, `Exception 3 shares the same exception handling with Exception 1, so it was 
    added as a &quot;Co-Catch&quot; in the same handling sequence.`, plain=`Exception 3 shares the same exception handling with Exception 1, so it was added as a "Co-Catch" in the same handling sequence.`);
        }
        catch(15, `<b>Exception 2</b>`, plain=`Exception 2`, headingWidth=21) {
            simple(15.1, e1b5c243, `Sequence for handling the second exception`, plain=`Sequence for handling the second exception`);
        }
        catch(41, `<b>Tagged break</b>`, plain=`Tagged break`) {
            simple(41.1, f7dc3b9f, `Neuer Schritt 1`, plain=`Neuer Schritt 1`, tags=[(`label_only`, `Catch area headings are not actually steps and therefore don't support the attachment of tags. The steps in the handling sequence of course do.`)]);
        }
    }
}

outro(`<div>
      This is the outro of a usecase
    </div>
    <h2>
      Images
    </h2>`, plain=`This is the outro of a usecase
Images`) {
    image(scale=42.07%, type=png) { [base64:] }
    text(`<div>
      Images can be imported from file and are embedded in the document, so 
      that the model is completely self-contained. They can be placed in every 
      edit container, not only the intro or outro of the specification. The 
      image above was imported from src/main/resources/images/specman-300.png 
      and manually scaled down.
    </div>
    <div>
      
    </div>
    <h3>
      Image added in yellow change set
    </h3>`, plain=`Images can be imported from file and are embedded in the document, so that the model is completely self-contained. They can be placed in every edit container, not only the intro or outro of the specification. The image above was imported from src/main/resources/images/specman-300.png and manually scaled down.

Image added in yellow change set`)
    image(scale=100%, type=png, change=(added, yellow)) { [base64:] }
    text(`<h3>
      Image removed in yellow change set
    </h3>`, plain=`Image removed in yellow change set`)
    image(scale=100%, type=png, change=(removed, yellow)) { [base64:] }
    text(``, plain=``)
}
