    class Order was(blue, Bestellung) (3c000002) at(260, 800) {
        -number : String
        -date (3c000011) change(added, blue) : Date
        -note (3c000012) change(removed, blue) : String
        -status : String was(blue, Integer)
    }
    class Invoice (3c000003) change(added, blue) at(560, 800) {
        -amount : Decimal
    }
    class Legacy (3c000004) change(removed, blue) at(260, 1020) {
        -oldKey : String
    }

    association (3c000021) 3c000001 1 -> * 3c000002 "places" was(blue, "orders")
    composition (3c000022) change(added, blue) 3c000002 1 -> 0..1 3c000003 "billed by"
        route 3c000002.right@70 (500, 870) (500, 822) 3c000003.left@22
    association (3c000023) change(removed, blue) 3c000002 -- 3c000004 "uses"
        route 3c000002.left@70 (210, 870) (210, 1045) 3c000004.left@25

