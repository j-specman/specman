// {"classmanVersion":"0.1","modelType":"classman.model.v001.ClassDiagramModel_V001"}
// One small model with a typical mix of changes, once per change set, to compare the colors.
classdiagram "Change colors" {

    note at(0, -40) width=120 "yellow"

    class Customer (1c000001) at(0, 0) {
        -name : String
        -email : String
    }
    class Order was(yellow, Bestellung) (1c000002) at(260, 0) {
        -number : String
        -date (1c000011) change(added, yellow) : Date
        -note (1c000012) change(removed, yellow) : String
        -status : String was(yellow, Integer)
    }
    class Invoice (1c000003) change(added, yellow) at(560, 0) {
        -amount : Decimal
    }
    class Legacy (1c000004) change(removed, yellow) at(260, 220) {
        -oldKey : String
    }

    association (1c000021) 1c000001 1 -> * 1c000002 "places" was(yellow, "orders")
    composition (1c000022) change(added, yellow) 1c000002 1 -> 0..1 1c000003 "billed by"
        route 1c000002.right@70 (500, 70) (500, 22) 1c000003.left@22
    association (1c000023) change(removed, yellow) 1c000002 -- 1c000004 "uses"
        route 1c000002.left@70 (210, 70) (210, 245) 1c000004.left@25

    note (1c000031) change(added, yellow) at(580, 170) width=170 "Invoices are new"
    note (1c000032) at(400, 235) width=190 "Orders are billed" was(yellow, "Orders are free")

    note at(0, 360) width=120 "lilac"

    class Customer (2c000001) at(0, 400) {
        -name : String
        -email : String
    }
