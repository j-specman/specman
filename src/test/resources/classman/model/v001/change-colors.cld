    class Invoice (2c000003) change(added, lilac) at(560, 400) {
        -amount : Decimal
    }
    class Legacy (2c000004) change(removed, lilac) at(260, 620) {
        -oldKey : String
    }

    association (2c000021) 2c000001 1 -> * 2c000002 "places" was(lilac, "orders")
    composition (2c000022) change(added, lilac) 2c000002 1 -> 0..1 2c000003 "billed by"
        route 2c000002.right@70 (500, 470) (500, 422) 2c000003.left@22
    association (2c000023) change(removed, lilac) 2c000002 -- 2c000004 "uses"
        route 2c000002.left@70 (210, 470) (210, 645) 2c000004.left@25

    note (2c000031) change(added, lilac) at(580, 570) width=170 "Invoices are new"
    note (2c000032) at(400, 635) width=190 "Orders are billed" was(lilac, "Orders are free")

    note at(0, 760) width=120 "blue"

