        -name : String
        -email : String
    }
    class Order was(orange, Bestellung) (4c000002) at(260, 1200) {
        -number : String
        -date (4c000011) change(added, orange) : Date
        -note (4c000012) change(removed, orange) : String
        -status : String was(orange, Integer)
    }
    class Invoice (4c000003) change(added, orange) at(560, 1200) {
