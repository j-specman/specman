    note (5c000031) change(added, pink) at(580, 1770) width=170 "Invoices are new"
    note (5c000032) at(400, 1835) width=190 "Orders are billed" was(pink, "Orders are free")
    anchor change(added, yellow) 1c000031 -- 1c000003
    anchor 1c000032 -- 1c000002
    anchor change(added, lilac) 2c000031 -- 2c000003
    anchor 2c000032 -- 2c000002
    anchor change(added, blue) 3c000031 -- 3c000003
    anchor 3c000032 -- 3c000002
    anchor change(added, orange) 4c000031 -- 4c000003
    anchor 4c000032 -- 4c000002
    anchor change(added, pink) 5c000031 -- 5c000003
    anchor 5c000032 -- 5c000002
