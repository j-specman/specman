// {"classmanVersion":"0.1","modelType":"classman.model.v001.ClassDiagramModel_V001"}
// Syntax test only: the benchmark diagram expressed in the draft format. Positions are taken from the
// hand-made grid image, most routes are left out (center-to-center), so this is not a finished rendering.
classdiagram `Hilfe-Versionierung` {

    class Hilfeversion (04de91aa) at(361, 45) <<Entity>> {TABLENAME=helpversion} {
        -Versionsnummer : String [Pflicht, 2..50, TN=versionkey]
        ...
    }
    class Hilfeversion-Markup at(762, 44) {
        -Sprache
        -Beschreibung : CLOB
    }
    class Hilfeeintrag at(549, 134) {
        -Positionsschlüssel : String [Pflicht]
        -`In Baum anzeigen` : J/N
        -`autom Mandantenauswahl` : J/N
        -`Weiterleitung zu Position` : String
        -Formel : String
    }
    class Hilfetextblock at(763, 135) {
        -`autom Mandantenauswahl` : J/N
        -`lfd Nummer` : Zahl
    }
    class Hilfe-Markup at(973, 257) {
        -Sprache
        -Beschreibung : CLOB
    }
    class Hilfekategorie at(190, 257) {
        -Level : Zahl
        -`lfd Nummer` : Zahl
        -optional : J/N
        -schemaabhängig : J/N
        -Resourcenschlüssel : String
    }
    class Mandant at(708, 284) {
    }
    class Handbuchseite at(549, 508) {
        -Seitenschlüssel : String [Pflicht]
        -`In Baum anzeigen` : J/N
    }
    class Handbuchtextblock at(761, 506) {
        -`lfd Nummer` : Zahl
    }
    class Handbuch-Markup at(973, 380) {
        -Sprache
        -Beschreibung : CLOB
    }
    class Handbuchseitenbezeichnung at(762, 619) {
        -Sprache
        -Bezeichnung : String
    }

    composition Hilfeversion 1 -> * Hilfeversion-Markup `sprachabh. Beschreibung`
        route Hilfeversion.right@18 Hilfeversion-Markup.left@18
    composition Hilfeversion 1 -> * Hilfekategorie `definiert für Handbuchseiten\nund Erfassungsleitfaden`
    composition Hilfeversion 1 -> * Hilfeeintrag `definiert für\nErfassungs-\nleitfaden`
        route Hilfeversion.bottom@90 (451, 118) (620, 118) Hilfeeintrag.top@71
    association Hilfeversion * -> * Hilfeeintrag `erbt aus\nVorgänger-\nversionen`
    composition Hilfeversion 1 -> * Handbuchseite `definiert für\nBenutzer-\nhandbuch`
    association Hilfeversion * -> * Handbuchseite `erbt aus\nVorgänger-\nversionen`

    composition Hilfeeintrag 1 -> 1..* Hilfetextblock `definiert`
    composition Hilfetextblock 1 -> 1..* Hilfe-Markup `sprachabh. Inhalt`
    composition Handbuchseite 1 -> 1..* Handbuchtextblock `definiert`
    composition Handbuchtextblock 1 -> 1..* Handbuch-Markup `sprachabh. Inhalt`
    composition Handbuchseite 1 -> 1..* Handbuchseitenbezeichnung `sprachabh. Bezeichnung`

    association Hilfekategorie * -> * Hilfeeintrag `kategorisiert`
        assocclass helpentrycategory at(330, 190) {
        }
    association Hilfekategorie * -> * Handbuchseite `kategorisiert`
        assocclass manualpagecategory {
            -`Seitenzahl in Kategorie` : Zahl
        }
    association Hilfeeintrag * -> * Mandant `sichtbar für`
        route Hilfeeintrag.right@60 (745, 194) Mandant.top@37
        assocclass helpentryinmandate at(790, 200) {
        }
    association Hilfetextblock * -> * Mandant `sichtbar für`
        assocclass helptextblockinmandate {
        }
    association Handbuchseite * -> * Mandant `sichtbar für`
        assocclass manualpageinmandate {
        }
    association Handbuchtextblock * -> * Mandant `sichtbar für`
        assocclass manualtextblockinmandate {
        }

    note at(92, 380) width=165 `Aus Level und lfd. Nummer ergibt sich eine Baumstruktur aller Hilfekategorien. Kategorien und deren Zuordnungen zu Handbuchseiten und Hilfeeinträgen werden nicht vererbt sondern bei Neuanlage einer Version kopiert.` attached Hilfekategorie
    note at(549, 670) `Mindestens\nEnglisch muss\nvorhanden sein` attached Handbuchseitenbezeichnung
}
