<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.specman</groupId>
    <artifactId>specman</artifactId>
    <version>1.4.0</version>
    <packaging>jar</packaging>

    <repositories>
        <repository>
            <id>specman-local-repo</id>
            <name>Local Repository with non public libraries</name>
            <url>file://${project.basedir}/local-maven-repository/</url>
        </repository>
    </repositories>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <flatlaf.version>3.5</flatlaf.version>
        <itext.version>9.4.0</itext.version>
        <!-- Output of jpackage in the windows-installer profile; global because the pre-clean unlock below needs it without the profile -->
        <specman.inno.appImageDir>${project.build.directory}/jpackage-app-image</specman.inno.appImageDir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jgoodies</groupId>
            <artifactId>jgoodies-forms</artifactId>
            <version>1.9.0</version>
        </dependency>

        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.5</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.5</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.9.9</version>
        </dependency>

        <dependency>
            <groupId>net.attlanticbb</groupId>
            <artifactId>shef</artifactId>
            <version>0.5.0</version>
        </dependency>

        <dependency>
            <groupId>net.attlanticbb</groupId>
            <artifactId>sam</artifactId>
            <version>0.5.0</version>
        </dependency>

        <dependency>
            <groupId>net.attlanticbb</groupId>
            <artifactId>novaworx-syntax</artifactId>
            <version>0.0.7</version>
        </dependency>

        <dependency>
            <groupId>net.attlanticbb</groupId>
            <artifactId>jtidy</artifactId>
            <version>8.0</version>
        </dependency>

        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- SVG renderer used for crisp, zoom-proof vector icons (e.g. KlappButton's plus/minus),
             as opposed to the bitmap icons under images/*.png which pixelate when scaled. -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- always needed -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>kernel</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>io</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>layout</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>forms</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>pdfa</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>sign</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>barcodes</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>font-asian</artifactId>
            <version>${itext.version}</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>hyph</artifactId>
            <version>${itext.version}</version>
        </dependency>


        <dependency>
            <groupId>org.asciidoctor</groupId>
            <artifactId>asciidoctorj</artifactId>
            <version>2.5.7</version>
        </dependency>

        <!-- https://www.baeldung.com/java-difference-between-two-strings -->
        <dependency>
            <groupId>org.bitbucket.cowwoc</groupId>
            <artifactId>diff-match-patch</artifactId>
            <version>1.2</version>
        </dependency>

        <dependency>
	        <groupId>org.junit.jupiter</groupId>
	        <artifactId>junit-jupiter-engine</artifactId>
	        <version>5.4.0</version>
	        <scope>test</scope>
	    </dependency>

        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.languagetool</groupId>
            <artifactId>languagetool-core</artifactId>
            <version>6.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.languagetool</groupId>
            <artifactId>language-de</artifactId>
            <version>6.8</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.0.1</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.1</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/antlr4</directory>
                <includes>
                    <include>**/*.g4</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>
                                        specman.Specman
                                    </mainClass>
                                </manifest>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <echo
                                    file="src/main/resources/specman-version.properties"
                                    message="version=${project.version}${line.separator}by=${user.name}${line.separator}"/>
                                <!--
                                    Minor-version slice of project.version (e.g. 1.3.1 -> 1.3), exported as a real Maven
                                    property via exportAntProperties so it is usable from other executions/profiles too
                                    (e.g. the windows-installer profile and the release-bundle profile), instead of each
                                    recomputing it locally.
                                -->
                                <loadresource property="specman.release.version">
                                    <string value="${project.version}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="^(\d+\.\d+).*$" replace="\1"/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>
                                <!-- GUI launcher: javaw (no console), waits for a key press after an error so that a double click shows the message -->
                                <copy file="${project.basedir}/howto/template-specman.bat" tofile="${project.build.directory}/specman.bat"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <filter token="VERSION" value="${project.version}"/>
                                        <filter token="MIN_JAVA_VERSION" value="${maven.compiler.target}"/>
                                        <filter token="JAVA_EXE" value="javaw"/>
                                        <filter token="PAUSE" value="pause"/>
                                    </filterset>
                                </copy>
                                <!-- Console launcher for command-line operations like sanitizing (e.g. for AI agents): java, never waits, returns the exit code -->
                                <copy file="${project.basedir}/howto/template-specman.bat" tofile="${project.build.directory}/specman-cli.bat"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <filter token="VERSION" value="${project.version}"/>
                                        <filter token="MIN_JAVA_VERSION" value="${maven.compiler.target}"/>
                                        <filter token="JAVA_EXE" value="java"/>
                                        <filter token="PAUSE" value="rem"/>
                                    </filterset>
                                </copy>
                                <copy file="${project.basedir}/howto/template-specman.sh" tofile="${project.build.directory}/specman.sh"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <filter token="VERSION" value="${project.version}"/>
                                        <filter token="MIN_JAVA_VERSION" value="${maven.compiler.target}"/>
                                    </filterset>
                                </copy>
                                <chmod file="${project.build.directory}/specman.sh" perm="755"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!--
                        jpackage creates the launchers in the app image read-only, which maven-clean-plugin
                        can't delete on Windows ("Failed to delete ...Specman.exe"). Clearing the flag in
                        pre-clean lets "mvn clean" work on a previously built app image. Deliberately part of
                        the main build, not of the windows-installer profile: it must also run for a plain
                        "mvn clean" or "mvn -P release-bundle clean package" after an installer build.
                        Does nothing if there is no app image.
                    -->
                    <execution>
                        <id>unlock-inno-app-image</id>
                        <phase>pre-clean</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <attrib readonly="false">
                                    <fileset dir="${specman.inno.appImageDir}" erroronmissingdir="false"/>
                                </attrib>
                            </target>
                        </configuration>
                    </execution>

                    <!--
                        Generates readme.adoc from howto/template-readme.adoc and the region between
                        '// tag::readme[]' and '// end::readme[]' in doc/specman-manual.adoc.
                        GitHub doesn't resolve AsciiDoc includes, so the readme must be a real copy.
                        Standalone usage: mvn antrun:run@generate-readme
                        The regular expressions below are vibe-coded, so don't expect them to be human-readable
                        tag::ID[] / end::ID[] is AsciiDoc's own tagged-region syntax (normally used with include::[tags=ID]);
                        we reuse it here for a familiar, tool-recognizable marker, even though AsciiDoc includes are not applicable here.
                    -->
                    <execution>
                        <id>generate-readme</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="Tag markers '// tag::readme[]' / '// end::readme[]' missing in doc/specman-manual.adoc">
                                    <condition>
                                        <not>
                                            <and>
                                                <resourcecontains resource="${project.basedir}/doc/specman-manual.adoc" substring="// tag::readme[]"/>
                                                <resourcecontains resource="${project.basedir}/doc/specman-manual.adoc" substring="// end::readme[]"/>
                                            </and>
                                        </not>
                                    </condition>
                                </fail>
                                <loadfile property="manual.excerpt" srcFile="${project.basedir}/doc/specman-manual.adoc" encoding="UTF-8">
                                    <filterchain>
                                        <!-- Extracts everything between the tag::readme[] and end::readme[] marker comments -->
                                        <tokenfilter>
                                            <filetokenizer/>
                                            <replaceregex pattern="^.*// tag::readme\[\][^\r\n]*\R(.*?)\R*// end::readme\[\].*$" replace="\1" flags="s"/>
                                        </tokenfilter>
                                        <!-- The readme lives in the project root, so relative image and link targets need the doc/ prefix -->
                                        <tokenfilter>
                                            <replaceregex pattern="(image::?|link:)(?!https?:)([^\[\s]+)\[" replace="\1doc/\2[" flags="g"/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadfile>
                                <copy file="${project.basedir}/howto/template-readme.adoc" tofile="${project.basedir}/readme.adoc"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <!--
                                            manual.excerpt is an Ant property set above by <loadfile>, not a Maven property -
                                            it only exists at Ant runtime within this target. IDEs that check ${...} against
                                            Maven properties (e.g. IntelliJ) will flag it as unresolvable; that is a false positive.
                                        -->
                                        <filter token="MANUAL_EXCERPT" value="${manual.excerpt}"/>
                                    </filterset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <!--
            Builds the Windows installer: jpackage creates the app image (launchers + bundled Java
            runtime), Inno Setup 6 turns it into a Setup EXE (see src/main/inno/specman.iss).
            Requires JDK 17+ (jpackage) and Inno Setup 6 (ISCC.exe on the PATH, or set -Dspecman.inno.iscc=<full path>).
            Usage: mvn -P windows-installer clean package
        -->
        <profile>
            <id>windows-installer</id>
            <properties>
                <specman.installer.vendor>Specman</specman.installer.vendor>
                <!-- Fixed on purpose: Inno's AppId must stay stable so that installing a newer version
                     upgrades the older one in place. It is the upgrade code of the former MSI installer. -->
                <specman.installer.appId>866b19a6-d061-4d12-bb20-89c895cc9f48</specman.installer.appId>
                <specman.installer.input>${project.build.directory}/jpackage-input</specman.installer.input>
                <specman.inno.extraDir>${project.build.directory}/inno-extra</specman.inno.extraDir>
                <specman.inno.iscc>ISCC.exe</specman.inno.iscc>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-inno-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${specman.installer.input}"/>
                                        <copy
                                            file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
                                            todir="${specman.installer.input}"/>

                                        <!--
                                            Grammar and matching reference model, same files as in the release-bundle profile.
                                            Staged outside the jpackage input (which ends up in app\) so that the installer
                                            puts them directly into the installation directory, like the release bundle.
                                        -->
                                        <fail message="No specman-reference-v${specman.release.version}-*.nsd found in ${project.basedir} for version ${project.version}">
                                            <condition>
                                                <resourcecount count="0">
                                                    <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                                </resourcecount>
                                            </condition>
                                        </fail>
                                        <mkdir dir="${specman.inno.extraDir}"/>
                                        <copy todir="${specman.inno.extraDir}" flatten="true">
                                            <fileset file="${project.basedir}/src/main/antlr4/specman/model/v002/SpecmanModel_V002.g4"/>
                                            <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <!-- Declared first so it runs before inno-compile within the package phase. -->
                            <execution>
                                <id>jpackage-app-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>Specman</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${specman.installer.vendor}</argument>
                                        <argument>--dest</argument>
                                        <argument>${specman.inno.appImageDir}</argument>
                                        <argument>--input</argument>
                                        <argument>${specman.installer.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>specman.Specman</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/images/specman.ico</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>specman-cli=${project.basedir}/src/main/jpackage/cli.properties</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-header-files --no-man-pages</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>inno-compile</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${specman.inno.iscc}</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>/DAppVersion=${project.version}</argument>
                                        <argument>/DAppId=${specman.installer.appId}</argument>
                                        <argument>/DAppPublisher=${specman.installer.vendor}</argument>
                                        <argument>/DSourceDir=${specman.inno.appImageDir}/Specman</argument>
                                        <argument>/DExtraDir=${specman.inno.extraDir}</argument>
                                        <argument>/DOutDir=${project.build.directory}</argument>
                                        <argument>/DProjectDir=${project.basedir}</argument>
                                        <argument>${project.basedir}/src/main/inno/specman.iss</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Assembles a portable release bundle: target/specman-installation/<major.minor>/ (the same
            layout that gets copied onto the fileserver by hand today) plus a matching zip for e.g. a
            GitHub release. Contains specman.bat/.sh, specman-cli.bat (console variant for command-line
            operations like sanitizing), the jar *with* dependencies (the plain jar is
            useless without them on the classpath), the grammar and the matching reference model - the
            latter two are first-class artifacts for AI-agent-assisted spec authoring, not just dev extras.
            Usage: mvn -P release-bundle package
        -->
        <profile>
            <id>release-bundle</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>assemble-release-bundle</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <fail message="No specman-reference-v${specman.release.version}-*.nsd found in ${project.basedir} for version ${project.version}">
                                            <condition>
                                                <resourcecount count="0">
                                                    <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                                </resourcecount>
                                            </condition>
                                        </fail>
                                        <property name="specman.releaseBundle.dir" value="${project.build.directory}/specman-installation/${specman.release.version}"/>
                                        <mkdir dir="${specman.releaseBundle.dir}"/>
                                        <copy todir="${specman.releaseBundle.dir}" flatten="true">
                                            <fileset file="${project.build.directory}/specman.bat"/>
                                            <fileset file="${project.build.directory}/specman-cli.bat"/>
                                            <fileset file="${project.build.directory}/specman.sh"/>
                                            <fileset file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"/>
                                            <fileset file="${project.basedir}/src/main/antlr4/specman/model/v002/SpecmanModel_V002.g4"/>
                                            <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                            <fileset file="${project.basedir}/src/main/resources/images/specman.png"/>
                                        </copy>
                                        <chmod file="${specman.releaseBundle.dir}/specman.sh" perm="755"/>
                                        <!-- Doc entry point for the zip: just a pointer to the manual on GitHub, not a copy of doc/ -->
                                        <copy file="${project.basedir}/howto/template-specman-readme.html" tofile="${specman.releaseBundle.dir}/specman-readme.html"
                                              overwrite="true" encoding="UTF-8">
                                            <filterset>
                                                <filter token="VERSION" value="${project.version}"/>
                                            </filterset>
                                        </copy>

                                        <!--
                                            Zip the files at archive root (no specman-installation/<version>/ wrapper
                                            folder) - nicer "unzip and run" experience for a GitHub release than for
                                            the fileserver copy. specman.sh needs an explicit filemode, since Ant only
                                            carries over real Unix permissions when the build itself runs on Unix -
                                            on this Windows build host it would otherwise lose its executable bit.
                                        -->
                                        <zip destfile="${project.build.directory}/specman-${project.version}-portable.zip">
                                            <zipfileset dir="${specman.releaseBundle.dir}" excludes="specman.sh"/>
                                            <zipfileset dir="${specman.releaseBundle.dir}" includes="specman.sh" filemode="755"/>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>