        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/antlr4</directory>
                <includes>
                    <include>**/*.g4</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <archive>
                                <manifest>
                                    <mainClass>
                                        specman.Specman
                                    </mainClass>
                                </manifest>
                            </archive>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <echo
                                    file="src/main/resources/specman-version.properties"
                                    message="version=${project.version}${line.separator}by=${user.name}${line.separator}"/>
                                <!--
                                    Minor-version slice of project.version (e.g. 1.3.1 -> 1.3), exported as a real Maven
                                    property via exportAntProperties so it is usable from other executions/profiles too
                                    (e.g. the windows-installer profile and the release-bundle profile), instead of each
                                    recomputing it locally.
                                -->
                                <loadresource property="specman.release.version">
                                    <string value="${project.version}"/>
                                    <filterchain>
                                        <tokenfilter>
                                            <replaceregex pattern="^(\d+\.\d+).*$" replace="\1"/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadresource>
                                <copy file="${project.basedir}/howto/template-specman.bat" tofile="${project.build.directory}/specman.bat"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <filter token="VERSION" value="${project.version}"/>
                                        <filter token="MIN_JAVA_VERSION" value="${maven.compiler.target}"/>
                                    </filterset>
                                </copy>
                                <copy file="${project.basedir}/howto/template-specman.sh" tofile="${project.build.directory}/specman.sh"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <filter token="VERSION" value="${project.version}"/>
                                        <filter token="MIN_JAVA_VERSION" value="${maven.compiler.target}"/>
                                    </filterset>
                                </copy>
                                <chmod file="${project.build.directory}/specman.sh" perm="755"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>

                    <!--
                        Generates readme.adoc from howto/template-readme.adoc and the region between
                        '// tag::readme[]' and '// end::readme[]' in doc/specman-manual.adoc.
                        GitHub doesn't resolve AsciiDoc includes, so the readme must be a real copy.
                        Standalone usage: mvn antrun:run@generate-readme
                        The regular expressions below are vibe-coded, so don't expect them to be human-readable
                        tag::ID[] / end::ID[] is AsciiDoc's own tagged-region syntax (normally used with include::[tags=ID]);
                        we reuse it here for a familiar, tool-recognizable marker, even though AsciiDoc includes are not applicable here.
                    -->
                    <execution>
                        <id>generate-readme</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="Tag markers '// tag::readme[]' / '// end::readme[]' missing in doc/specman-manual.adoc">
                                    <condition>
                                        <not>
                                            <and>
                                                <resourcecontains resource="${project.basedir}/doc/specman-manual.adoc" substring="// tag::readme[]"/>
                                                <resourcecontains resource="${project.basedir}/doc/specman-manual.adoc" substring="// end::readme[]"/>
                                            </and>
                                        </not>
                                    </condition>
                                </fail>
                                <loadfile property="manual.excerpt" srcFile="${project.basedir}/doc/specman-manual.adoc" encoding="UTF-8">
                                    <filterchain>
                                        <!-- Extracts everything between the tag::readme[] and end::readme[] marker comments -->
                                        <tokenfilter>
                                            <filetokenizer/>
                                            <replaceregex pattern="^.*// tag::readme\[\][^\r\n]*\R(.*?)\R*// end::readme\[\].*$" replace="\1" flags="s"/>
                                        </tokenfilter>
                                        <!-- The readme lives in the project root, so relative image and link targets need the doc/ prefix -->
                                        <tokenfilter>
                                            <replaceregex pattern="(image::?|link:)(?!https?:)([^\[\s]+)\[" replace="\1doc/\2[" flags="g"/>
                                        </tokenfilter>
                                    </filterchain>
                                </loadfile>
                                <copy file="${project.basedir}/howto/template-readme.adoc" tofile="${project.basedir}/readme.adoc"
                                      overwrite="true" encoding="UTF-8">
                                    <filterset>
                                        <!--
                                            manual.excerpt is an Ant property set above by <loadfile>, not a Maven property -
                                            it only exists at Ant runtime within this target. IDEs that check ${...} against
                                            Maven properties (e.g. IntelliJ) will flag it as unresolvable; that is a false positive.
                                        -->
                                        <filter token="MANUAL_EXCERPT" value="${manual.excerpt}"/>
                                    </filterset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <!--
            Builds a Windows MSI installer with a bundled Java runtime via jpackage.
            Requires JDK 17+ (jpackage) and the WiX Toolset (v3.14) on the PATH.
            Usage: mvn -P windows-installer clean verify
        -->
        <profile>
            <id>windows-installer</id>
            <properties>
                <specman.installer.vendor>Specman</specman.installer.vendor>
                <!-- Fixed on purpose: jpackage needs a stable upgrade code so that installing
                     a newer version replaces the older one instead of installing side by side. -->
                <specman.installer.upgradeUuid>866b19a6-d061-4d12-bb20-89c895cc9f48</specman.installer.upgradeUuid>
                <specman.installer.input>${project.build.directory}/jpackage-input</specman.installer.input>
                <specman.installer.dest>${project.build.directory}</specman.installer.dest>
                <specman.installer.wixResourceDir>${project.build.directory}/jpackage-wix</specman.installer.wixResourceDir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-jpackage-input</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${specman.installer.input}"/>
                                        <copy
                                            file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"
                                            todir="${specman.installer.input}"/>

                                        <!--
                                            Also install the grammar and a matching reference model, so users can
                                            open both without cloning the repo. The reference model to ship is
                                            picked by the project's own major.minor version (e.g. 1.3.1 -> 1.3,
                                            computed once as specman.release.version in the validate-phase execution),
                                            so a version bump without a matching specman-reference-vX.Y-*.nsd file
                                            in the repo root fails the build instead of shipping a stale/missing
                                            reference silently.
                                        -->
                                        <fail message="No specman-reference-v${specman.release.version}-*.nsd found in ${project.basedir} for version ${project.version}">
                                            <condition>
                                                <resourcecount count="0">
                                                    <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                                </resourcecount>
                                            </condition>
                                        </fail>
                                        <mkdir dir="${specman.installer.input}/docs"/>
                                        <copy todir="${specman.installer.input}/docs" flatten="true">
                                            <fileset file="${project.basedir}/src/main/antlr4/specman/model/v002/SpecmanModel_V002.g4"/>
                                            <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                        </copy>

                                        <!--
                                            Stage the WiX resource-dir override: main.wxs adds a File element
                                            for specman.cmd and WixVariables pointing at the branding bitmaps,
                                            but jpackage copies main.wxs into its own temp directory before
                                            compiling it, so WiX's sys.SOURCEFILEDIR can't be used to locate
                                            these files relative to it. Instead, copy them all into a
                                            build-local directory and bake their absolute paths into main.wxs
                                            here, before jpackage/candle ever run.
                                        -->
                                        <mkdir dir="${specman.installer.wixResourceDir}"/>
                                        <copy
                                            file="${project.basedir}/src/main/jpackage/wix/specman.cmd"
                                            todir="${specman.installer.wixResourceDir}"/>
                                        <copy
                                            file="${project.basedir}/src/main/jpackage/wix/banner.bmp"
                                            todir="${specman.installer.wixResourceDir}"/>
                                        <copy
                                            file="${project.basedir}/src/main/jpackage/wix/dialog.bmp"
                                            todir="${specman.installer.wixResourceDir}"/>
                                        <copy
                                            file="${project.basedir}/src/main/jpackage/wix/main.wxs"
                                            todir="${specman.installer.wixResourceDir}"
                                            overwrite="true">
                                            <filterset>
                                                <filter
                                                    token="specman.cmd.absolute.path"
                                                    value="${specman.installer.wixResourceDir}/specman.cmd"/>
                                                <filter
                                                    token="wix.banner.bmp.absolute.path"
                                                    value="${specman.installer.wixResourceDir}/banner.bmp"/>
                                                <filter
                                                    token="wix.dialog.bmp.absolute.path"
                                                    value="${specman.installer.wixResourceDir}/dialog.bmp"/>
                                            </filterset>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>

                            <!--
                                jpackage derives the output filename from the "name" argument (Specman), which
                                must stay capitalized because it also becomes the Start Menu entry, the
                                "Apps & Features" display name and the window title - jpackage has no separate
                                switch for just the filename. Renaming after the fact keeps the lowercase
                                "specman-<version>.msi" convention matching specman-<version>-portable.zip from
                                the release-bundle profile, without touching anything user-visible inside the
                                installed app. Bound to verify (runs after package, where jpackage produces the
                                file) so it doesn't depend on plugin declaration order within the package phase.
                            -->
                            <execution>
                                <id>lowercase-msi-filename</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <move file="${project.build.directory}/Specman-${project.version}.msi"
                                              tofile="${project.build.directory}/specman-${project.version}-windows.msi"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <execution>
                                <id>jpackage-windows-msi</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>msi</argument>
                                        <argument>--name</argument>
                                        <argument>Specman</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${specman.installer.vendor}</argument>
                                        <argument>--dest</argument>
                                        <argument>${specman.installer.dest}</argument>
                                        <argument>--input</argument>
                                        <argument>${specman.installer.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>specman.Specman</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/images/specman.ico</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>Specman</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-per-user-install</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>${specman.installer.upgradeUuid}</argument>
                                        <argument>--file-associations</argument>
                                        <argument>${project.basedir}/src/main/jpackage/nsd.properties</argument>
                                        <argument>--add-launcher</argument>
                                        <argument>specman-cli=${project.basedir}/src/main/jpackage/cli.properties</argument>
                                        <argument>--resource-dir</argument>
                                        <argument>${specman.installer.wixResourceDir}</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dfile.encoding=UTF-8</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-header-files --no-man-pages</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Assembles a portable release bundle: target/specman-installation/<major.minor>/ (the same
            layout that gets copied onto the fileserver by hand today) plus a matching zip for e.g. a
            GitHub release. Contains specman.bat/.sh, the jar *with* dependencies (the plain jar is
            useless without them on the classpath), the grammar and the matching reference model - the
            latter two are first-class artifacts for AI-agent-assisted spec authoring, not just dev extras.
            Usage: mvn -P release-bundle package
        -->
        <profile>
            <id>release-bundle</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>assemble-release-bundle</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <fail message="No specman-reference-v${specman.release.version}-*.nsd found in ${project.basedir} for version ${project.version}">
                                            <condition>
                                                <resourcecount count="0">
                                                    <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                                </resourcecount>
                                            </condition>
                                        </fail>
                                        <property name="specman.releaseBundle.dir" value="${project.build.directory}/specman-installation/${specman.release.version}"/>
                                        <mkdir dir="${specman.releaseBundle.dir}"/>
                                        <copy todir="${specman.releaseBundle.dir}" flatten="true">
                                            <fileset file="${project.build.directory}/specman.bat"/>
                                            <fileset file="${project.build.directory}/specman.sh"/>
                                            <fileset file="${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar"/>
                                            <fileset file="${project.basedir}/src/main/antlr4/specman/model/v002/SpecmanModel_V002.g4"/>
                                            <fileset dir="${project.basedir}" includes="specman-reference-v${specman.release.version}-*.nsd"/>
                                            <fileset file="${project.basedir}/src/main/resources/images/specman.png"/>
                                        </copy>
                                        <chmod file="${specman.releaseBundle.dir}/specman.sh" perm="755"/>
                                        <!-- Doc entry point for the zip: just a pointer to the manual on GitHub, not a copy of doc/ -->
                                        <copy file="${project.basedir}/howto/template-specman-readme.html" tofile="${specman.releaseBundle.dir}/specman-readme.html"
                                              overwrite="true" encoding="UTF-8">
                                            <filterset>
                                                <filter token="VERSION" value="${project.version}"/>
                                            </filterset>
                                        </copy>

                                        <!--
                                            Zip the files at archive root (no specman-installation/<version>/ wrapper
                                            folder) - nicer "unzip and run" experience for a GitHub release than for
                                            the fileserver copy. specman.sh needs an explicit filemode, since Ant only
                                            carries over real Unix permissions when the build itself runs on Unix -
                                            on this Windows build host it would otherwise lose its executable bit.
                                        -->
                                        <zip destfile="${project.build.directory}/specman-${project.version}-portable.zip">
                                            <zipfileset dir="${specman.releaseBundle.dir}" excludes="specman.sh"/>
                                            <zipfileset dir="${specman.releaseBundle.dir}" includes="specman.sh" filemode="755"/>
                                        </zip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>