settings {
    width=433
    zoom=100
    changeModeEnabled=false
    changeSetName=yellow
}

intro(``, plain=``) {
}

mainSequence {
    subsequence(1, 7a1d3c50, `<h2>
      Compact Break Flavour
    </h2>`, plain=`Compact Break Flavour`, deco=Full) {
        simple(1.1, c2e84f11, `The user enters the customer number.`, plain=`The user enters the customer number.`);
        simple(1.2, 5b09a7d2, `The system looks up the customer by the customer number.`, plain=`The system looks up the customer by the customer number.`);
        break(1.3, e6f1203b, `<b>Customer not found</b>`, plain=`Customer not found`);
        simple(1.4, 18d5c9a4, `. . .`, plain=`. . .`);
    }
    subsequence(2, 94b7e6c3, `<h2>
      Comprehensive Break Flavour
    </h2>`, plain=`Comprehensive Break Flavour`, deco=Co) {
        simple(2.1, 3fa2d815, `The user presses the button <b>Delete</b>.`, plain=`The user presses the button Delete.`);
        simple(2.2, d07c4e26, `<div>
      The system checks
    </div>`, plain=`The system checks`) {
            list(ordered=false) {
                item(`<div>
      if there are orders of the customer which have not been delivered or 
      paid yet or
    </div>`, plain=`if there are orders of the customer which have not been delivered or paid yet or`)
                item(`<div>
      if there are any invoices of the customer still open.
    </div>`, plain=`if there are any invoices of the customer still open.`)
            }
        }
        break(2.3, 6e93b0f7, `<b>Open orders</b>`, plain=`Open orders`);
        break(2.4, a58f1c38, `<b>Open invoices</b>`, plain=`Open invoices`);
        simple(2.5, 0b4d7e69, `. .`, plain=`. .`);
    }
    subsequence(3, 52740972, `<h2>
      Catch and Co-Catch
    </h2>`, plain=`Catch and Co-Catch`) {
        simple(3.1, 1e6645bf, `The user enters the customer number.`, plain=`The user enters the customer number.`);
        simple(3.2, b7defb62, `The system looks up the customer by the customer number.`, plain=`The system looks up the customer by the customer number.`);
        break(3.3, c2fe84c7, `<b>Customer not found</b>`, plain=`Customer not found`);
        simple(3.4, 664009e7, `<div>
      The system checks
    </div>`, plain=`The system checks`) {
            list(ordered=false) {
                item(`<div>
      if there are orders of the customer which have not been delivered or 
      paid yet or
    </div>`, plain=`if there are orders of the customer which have not been delivered or paid yet or`)
                item(`<div>
      if there are any invoices of the customer still open.
    </div>`, plain=`if there are any invoices of the customer still open.`)
            }
        }
        break(3.5, 7c8c5e21, `<b>Open orders</b>`, plain=`Open orders`);
        break(3.6, 290e5832, `<b>Open invoices</b>`, plain=`Open invoices`);
        simple(3.7, c0c4bcce, `. . .`, plain=`. . .`);
        catchArea {
            catch(3.3, `<b>Customer not found</b>`, plain=`Customer not found`) {
                simple(3.3.1, 169fc2b6, `The system displays a notification message and clears the user input`, plain=`The system displays a notification message and clears the user input`);
            }
            catch(3.5, `<b>Open orders</b>`, plain=`Open orders`) {
                coCatch(3.6, `<b>Open invoices</b>`, plain=`Open invoices`);
                simple(3.5.1, 2fc76071, `The system displays an appropriate error message`, plain=`The system displays an appropriate error message`);
            }
        }
    }
}

outro(``, plain=``) {
}
