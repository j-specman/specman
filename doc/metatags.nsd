mainSequence {
    subsequence(1, c5c91980, `<h2>
      <b>Delete customer</b>
    </h2>`, plain=`Delete customer`, deco=Full) {
        simple(1.1, ea41dc1f, `If the user wants to delete the customer, they press the button <b>Delete</b>.`, plain=`If the user wants to delete the customer, they press the button Delete.`, tags=[(`User`)]);
