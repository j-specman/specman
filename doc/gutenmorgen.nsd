// Specman: frame0
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(...) { [base64:...] } blocks: embedded binary image data (base64-encoded)

settings {
    width=483
    zoom=100
    changeModeEnabled=false
    changeSetName=yellow
    pdfOptions {
        filename=`gutenmorgen-export.pdf`
        pageSize=A4
        portrait=true
        paging=false
    }
}

intro(`<h1>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Guten 
      Morgen</font></span>
    </h1>`, plain=`Guten Morgen`) {
}

mainSequence {
    simple(1, fcee183f, `W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ecker 
    klingelt</font></span>`, plain=`Wecker klingelt`, shade=#ffffff);
    ifElse(2, 3553aa8b, `<div align="center">
      W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ochentag 
      pr&#252;fen</font></span>
    </div>`, plain=`Wochentag prüfen`, ifRatio=23.69%, shade=#ffffff) {
        if_branch(`S<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">amstag 
    oder Sonntag</font></span>`, plain=`Samstag oder Sonntag`) {
            simple(2.1, 3410819d, `<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Wecker 
    ausmachen</font></span>`, plain=`Wecker ausmachen`, shade=#ffffff);
            simple(2.2, afce49e5, `W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ieder 
    umdrehen</font></span>`, plain=`Wieder umdrehen`, shade=#ffffff);
            simple(2.3, c7a9a7ec, `W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">eiterschlafen</font></span>`, plain=`Weiterschlafen`, shade=#ffffff);
        }
        else_branch(`<div align="right">
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Werktag</font></span>
    </div>`, plain=`Werktag`) {
            while(3.1, b2273919, `S<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">olange 
    ich noch nicht richtig wach bin und noch wenigstens 5 Minuten Zeit bleiben</font></span>`, plain=`Solange ich noch nicht richtig wach bin und noch wenigstens 5 Minuten Zeit bleiben`, barWidth=18, shade=#ffffff) {
                simple(3.1.1, edae09be, `W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ecker 
    <strike>ausmachen</strike> auf &quot;Snooze&quot; stellen</font></span>`, plain=`Wecker ausmachen auf "Snooze" stellen`, markups=[(7,15,Changed,yellow)(16,36,Changed,yellow)], shade=#ffffff);
                simple(3.1.2, 4a72e245, `A<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ugen 
    wieder schlie&#223;en</font></span>`, plain=`Augen wieder schließen`, shade=#ffffff);
            }
            simple(3.2, ec738318, `W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ecker 
    ausmachen</font></span>`, plain=`Wecker ausmachen`, shade=#ffffff);
            simple(3.3, 1b535ee9, `A<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ufstehen</font></span>`, plain=`Aufstehen`, shade=#ffffff);
            if(3.4, 9ea5860a, `<div align="center">
      L<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ust 
      auf einen Kaffee?</font></span>
    </div>`, plain=`Lust auf einen Kaffee?`, emptyWidth=20, shade=#ffffff) {
                if_branch(`<div align="right">
      Ja
    </div>`, plain=`Ja`) {
                    simple(3.4.1, 4360bd84, `K<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">affeemaschine 
    einschalten</font></span>`, plain=`Kaffeemaschine einschalten`, shade=#ffffff);
                }
            }
            simple(3.5, fee94d27, `D<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">uschen 
    gehen</font></span>`, plain=`Duschen gehen`, shade=#ffffff);
            simple(3.6, 1d45b9a5, `e<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">tc. 
    etc.</font></span>`, plain=`etc. etc.`, shade=#ffffff);
        }
    }
}

outro(``, plain=``) {
}
