// {"specmanVersion":"1.3.1","modelType":"specman.model.v002.DiagramModel_V002"}
// Specman: frame0
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(...) { [base64:...] } blocks: embedded binary image data (base64-encoded)

settings {
    width=700
    zoom=100
    changeModeEnabled=false
    changeSetName=yellow
}

intro(`<h1>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Find 
      Two-Word Anagramms</font></span>
    </h1>
    <h2>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Description 
      </font></span>
    </h2>
    <div>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">This 
      usecase finds all two-word anagrams of the word &#8220;documenting&#8221; based on a 
      vocabulary provided by file. A two-word anagramm is a combination of two 
      words which can be created from any arrangement of the letters which the 
      word &#8220;documenting&#8221; is build-up from. Example: The words &quot;document&quot; and 
      &quot;gin&quot; are a two-word anagram of &quot;documenting&quot;. </font></span>
    </div>
    <h2>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Specification 
      </font></span>
    </h2>`, plain=`Find Two-Word Anagramms
Description 
This usecase finds all two-word anagrams of the word “documenting” based on a vocabulary provided by file. A two-word anagramm is a combination of two words which can be created from any arrangement of the letters which the word “documenting” is build-up from. Example: The words "document" and "gin" are a two-word anagram of "documenting". 
Specification `) {
}

mainSequence {
    subsequence(1, 462b3772, `<b><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Read 
    vocabulary</font></span></b>`, plain=`Read vocabulary`, shade=#ffffff) {
        simple(1.1, b5c6f47e, `<div>
      The system reads the file with the words of the vocabulary
    </div>
    <div>
      
    </div>
    <font size="3"><i>Note: There is a file wordlist.txt provided along with 
    this specification which can be used here.</i></font>`, plain=`The system reads the file with the words of the vocabulary

Note: There is a file wordlist.txt provided along with this specification which can be used here.`, shade=#ffffff);
        while(1.2, bfe6d51a, `For every line of the file, the system...`, plain=`For every line of the file, the system...`, barWidth=28, shade=#ffffff) {
            simple(1.2.1, cd2acf70, `<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">... 
    </font></span>splits the line at the word boundaries, made-up from a 
    continuous sequence of blanks and tabulators`, plain=`... splits the line at the word boundaries, made-up from a continuous sequence of blanks and tabulators`, shade=#ffffff);
            simple(1.2.2, ef3d59da, `<div>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">... 
      </font></span>appends all words obtained from the line to the vocabulary
    </div>
    <div>
      
    </div>
    <div>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3"><i>Example: 
      The line </i></font></span>
    </div>
    <pre><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3"><i>Peter Paul    Mary </i></font></span></pre>
    <div>
      <span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3"><i>contributes 
      the words &#8222;Peter&#8220;, &#8222;Paul&#8220;, and &#8222;Mary&#8220; to the vocabulary. There is no 
      check for special characters within the words required.</i></font></span>
    </div>`, plain=`... appends all words obtained from the line to the vocabulary

Example: The line 
Peter Paul    Mary 
contributes the words „Peter“, „Paul“, and „Mary“ to the vocabulary. There is no check for special characters within the words required.`, shade=#ffffff);
        }
        break(1.3, 91c89495, `<b><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Less 
    than two words in vocabulary</font></span></b>`, plain=`Less than two words in vocabulary`, shade=#ffffff);
    }
    subsequence(2, 7122a9a4, `<b><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Compose 
    and check word pairs</font></span></b>`, plain=`Compose and check word pairs`, shade=#ffffff) {
        simple(2.1, 2d51363f, `The system builds a sorted list of the letters from the word &quot;documenting&quot;`, plain=`The system builds a sorted list of the letters from the word "documenting"`, shade=#ffffff);
        simple(2.2, 09b48ffc, `For every word of the vocabulary the system composes a word pair with all its 
    subsequent<span style="background-color: rgba(255, 255, 255, 0.0)"><strike><font color="#000000">other</font></strike></span> 
    words within the

    <div>
      vocabulary.
    </div>
    <div>
      
    </div>
    <div>
      <font size="3"><i>Example:</i></font><i><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3"> 
      </font></span><font size="3">A vocabulary of the words O</font><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3">NE</font></span><font size="3">, 
      T</font><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3">WO</font></span><font size="3">, 
      </font><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3">THREE 
      </font></span><font size="3">and </font><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3">FOUR</font></span></i>
    </div>
    <div>
      <font size="3"><i>results in the word pairs </i></font><i><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000" size="3">ONE/TWO, 
      ONE/THREE, ONE/FOUR, TWO/THREE, TWO/FOUR and THREE/FOUR</font></span><font size="3">.</font></i>
    </div>`, plain=`For every word of the vocabulary the system composes a word pair with all its subsequentother words within the
vocabulary.

Example: A vocabulary of the words ONE, TWO, THREE and FOUR
results in the word pairs ONE/TWO, ONE/THREE, ONE/FOUR, TWO/THREE, TWO/FOUR and THREE/FOUR.`, markups=[(74,87,Changed,yellow)(88,92,Changed,yellow)], shade=#ffffff);
        while(2.3, 2492c08d, `For every word pair the system performs the following steps:`, plain=`For every word pair the system performs the following steps:`, barWidth=29, shade=#ffffff) {
            simple(2.3.1, 2605ca35, `The system builds a sorted list of letters from the concatenation of both 
    words of the pair in lower case.`, plain=`The system builds a sorted list of letters from the concatenation of both words of the pair in lower case.`, shade=#ffffff);
            if(2.3.2, 06dd40d1, `<div align="center">
      Compare letter lists from steps 2.1 and 2.3.1
    </div>`, plain=`Compare letter lists from steps 2.1 and 2.3.1`, markups=[(32,34,Steplink)(40,44,Steplink)], emptyWidth=20, shade=#ffffff) {
                if_branch(`<div align="right">
      Lists are equal, i.e. the word pair is a two-word anagramm
    </div>`, plain=`Lists are equal, i.e. the word pair is a two-word anagramm`) {
                    simple(2.3.2.1, 08259127, `The system adds the word pair to the list of found anagramms.`, plain=`The system adds the word pair to the list of found anagramms.`, shade=#ffffff);
                }
            }
        }
    }
    simple(3, f04b457b, `The system publishes the list of found anagramms.`, plain=`The system publishes the list of found anagramms.`, shade=#ffffff);
    catchArea {
        catch(1.3, `<b><span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Less 
    than two words in vocabulary</font></span></b>`, plain=`Less than two words in vocabulary`, headingWidth=15) {
            simple(1.3.1, c3945dbe, `The system cancels the process with an appropriate error message.`, plain=`The system cancels the process with an appropriate error message.`, shade=#ffffff);
        }
    }
}

outro(``, plain=``) {
}
