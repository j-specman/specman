// {"specmanVersion":"1.3.1","modelType":"specman.model.v002.DiagramModel_V002"}
// Specman: frame0
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(...) { [base64:...] } blocks: embedded binary image data (base64-encoded)

settings {
    width=483
    zoom=100
    changeModeEnabled=false
    changeSetName=yellow
    pdfOptions {
        filename=`gutenmorgen-export.pdf`
        pageSize=A4
        portrait=true
        paging=false
    }
}

intro(`<h1>
      G<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ood 
      Morning</font></span>
    </h1>`, plain=`Good Morning`) {
}

mainSequence {
    simple(1, 77dd0ffc, `T<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">he 
    alarm clock is ringing</font></span>`, plain=`The alarm clock is ringing`, shade=#ffffff);
    ifElse(2, ca44a1c4, `<div align="center">
      C<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">heck 
      day of week</font></span>
    </div>`, plain=`Check day of week`, ifRatio=22.55%, shade=#ffffff) {
        if_branch(`S<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">aturday 
    or Sunday</font></span>`, plain=`Saturday or Sunday`) {
            simple(2.1, fa745b18, `T<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">urn 
    off alarm clock</font></span>`, plain=`Turn off alarm clock`, shade=#ffffff);
            simple(2.2, f0bd61a9, `T<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">urn 
    over</font></span>`, plain=`Turn over`, shade=#ffffff);
            simple(2.3, f56d11e6, `C<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ontinue 
    sleeping</font></span>`, plain=`Continue sleeping`, shade=#ffffff);
        }
        else_branch(`<div align="right">
      W<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">orking 
      day</font></span>
    </div>`, plain=`Working day`) {
            while(3.1, f3cddda2, `<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">As 
    long as you are not really awake and have at least 5 minutes left</font></span>`, plain=`As long as you are not really awake and have at least 5 minutes left`, barWidth=18, shade=#ffffff) {
                simple(3.1.1, 9962c92b, `<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">Set 
    the alarm to &quot;snooze&quot; <strike>Turn off alarm clock</strike></font></span>`, plain=`Set the alarm to "snooze" Turn off alarm clock`, markups=[(0,25,Changed,yellow)(26,45,Changed,yellow)], shade=#ffffff);
                simple(3.1.2, 8b562e7d, `C<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">lose 
    your eyes</font></span>`, plain=`Close your eyes`, shade=#ffffff);
            }
            simple(3.2, 0c96162e, `Turn off alarm clock`, plain=`Turn off alarm clock`, shade=#ffffff);
            simple(3.3, 7de84832, `G<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">et 
    up</font></span>`, plain=`Get up`, shade=#ffffff);
            if(3.4, b78b0900, `<div align="center">
      L<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ike 
      some coffee?</font></span>
    </div>`, plain=`Like some coffee?`, emptyWidth=20, shade=#ffffff) {
                if_branch(`<div align="right">
      Y<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">es</font></span>
    </div>`, plain=`Yes`) {
                    simple(3.4.1, 66885318, `T<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">urn 
    on coffee machine</font></span>`, plain=`Turn on coffee machine`, shade=#ffffff);
                }
            }
            simple(3.5, 588f9e3a, `T<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">ake 
    a shower</font></span>`, plain=`Take a shower`, shade=#ffffff);
            simple(3.6, 12188e20, `e<span style="background-color: rgba(255, 255, 255, 0.0)"><font color="#000000">tc. 
    etc.</font></span>`, plain=`etc. etc.`, shade=#ffffff);
        }
    }
}

outro(``, plain=``) {
}
