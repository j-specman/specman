// {"specmanVersion":"1.4.0","modelType":"specman.model.v002.DiagramModel_V002"}
// Specman: Enter Vacation Request
// Format defined by grammar: SpecmanModel_V002.g4
// Step numbers (first parameter of each step): unique diagram-wide; referenced by catch blocks and step links in text; sanitizer renumbers consistently
// plain=`...` fields: plain-text rendition, regenerated by Specman on every sanitize run
// markups=[...] fields: change-tracking annotations, maintained by Specman
// image(..., type=png) { [base64:...] } blocks: embedded binary image data (base64-encoded)
// image(..., type=plantuml) { `...` } blocks: PlantUML source of a diagram, Specman renders the picture from it
// backup=(changeset, `...`) in a plantuml image: source from before that change set changed it, maintained by Specman, leave it alone

settings {
    width=675
    zoom=100
    changeModeEnabled=false
    changeSetName=yellow
    pdfOptions {
        filename=`C:\work\jlessner\opensource\specman\doc\uc331-request-vacation.pdf`
        modelFilename=`C:\work\jlessner\opensource\specman\doc\uc331-request-vacation.nsd`
        pageSize=A4
        portrait=true
        paging=false
    }
}

intro(`<h1>
      UC-331 Request vacation
    </h1>
    <h2>
      Description
    </h2>
    <div>
      Vacation is requested online only. The employee starts from the time 
      planning dashboard (see <a href="specman://uc-330"><i>UC-330 &quot;Time 
      planning dashboard&quot;</i></a>) and fills in the vacation request 
      form. This use case covers the entering and the submission of the 
      request.
    </div>
    <div>
      
    </div>
    <div>
      Every request needs the approval of the employee's supervisor, which is 
      a separate use case. Until the supervisor has decided, the request is 
      pending.
    </div>`, plain=`UC-331 Request vacation
Description
Vacation is requested online only. The employee starts from the time planning dashboard (see UC-330 "Time planning dashboard") and fills in the vacation request form. This use case covers the entering and the submission of the request.

Every request needs the approval of the employee's supervisor, which is a separate use case. Until the supervisor has decided, the request is pending.`) {
    text(`<h2>
      Trigger / Precondition
    </h2>`, plain=`Trigger / Precondition`)
    list(ordered=false) {
        item(`The employee is logged into the time planning system.`, plain=`The employee is logged into the time planning system.`)
        item(`The employee is already fully registered and thus assigned to a working 
    location.`, plain=`The employee is already fully registered and thus assigned to a working location.`)
        item(`The annual leave days of the employee for the current year are maintained.`, plain=`The annual leave days of the employee for the current year are maintained.`)
    }
    text(`<h2>
      Result / Postcondition
    </h2>`, plain=`Result / Postcondition`)
    list(ordered=false) {
        item(`The vacation request is submitted to the employee's supervisor for 
    approval,<br>see <a href="specman://uc-332"><i>UC-332 &quot;Approve vacation 
    request&quot;</i></a>.<br>`, plain=`The vacation request is submitted to the employee's supervisor for approval, see UC-332 "Approve vacation request". `)
        item(`An e-mail was sent to inform the supervisor about the pending request.`, plain=`An e-mail was sent to inform the supervisor about the pending request.`)
    }
    text(`<h2>
      Flow specification
    </h2>`, plain=`Flow specification`)
}

mainSequence {
    subsequence(1, 3c9e1a02, `<h2>
      <b>Show vacation request form</b>
    </h2>`, plain=`Show vacation request form`, deco=Full) {
        simple(1.1, d1e0e8c8, `To plan a vacation, the employee presses the <b>Vacation request</b> 
    button in the time planning dashboard (see <a href="specman://uc-330"><i>UC-330 
    &quot;Time planning dashboard&quot;</i></a> for details).`, plain=`To plan a vacation, the employee presses the Vacation request button in the time planning dashboard (see UC-330 "Time planning dashboard" for details).`);
        simple(1.2, 7b41d5e8, `The system shows the vacation request form with the employee and the 
    working location.`, plain=`The system shows the vacation request form with the employee and the working location.`);
        simple(1.3, c20f93a6, `The system determines the remaining leave days as the annual leave days 
    minus the leave days of all PENDING and APPROVED vacation requests of the 
    employee in the current year.`, plain=`The system determines the remaining leave days as the annual leave days minus the leave days of all PENDING and APPROVED vacation requests of the employee in the current year.`);
        simple(1.4, 5e8a04d1, `The leave days needed are initially empty and the <b>Request</b> button is 
    disabled.`, plain=`The leave days needed are initially empty and the Request button is disabled.`);
    }
    subsequence(2, e4a60b17, `<h2>
      <b>Enter and check period</b>
    </h2>`, plain=`Enter and check period`, deco=Co) {
        simple(2.1, 08c5f2d9, `The employee enters the first and the last day of the desired vacation. 
    Both days are part of it.`, plain=`The employee enters the first and the last day of the desired vacation. Both days are part of it.`) {
            text(`<div>
      <i><font size="3">Note:</font></i>
    </div>
    <div>
      <i><font size="3">The flow starts here again with every change of one of 
      the days.</font></i>
    </div>`, plain=`Note:
The flow starts here again with every change of one of the days.`)
        }
        simple(2.2, 6a3e9c40, `The system empties the leave days needed and disables the <b>Request</b> 
    button.`, plain=`The system empties the leave days needed and disables the Request button.`);
        simple(2.3, d1b87e25, `The system checks that both days are filled in and the last<strike>first</strike> 
    day is not before the first<strike>last</strike>.`, plain=`The system checks that both days are filled in and the lastfirst day is not before the firstlast.`, markups=[(55,58,Changed,yellow)(59,63,Changed,yellow)(87,91,Changed,yellow)(92,95,Changed,yellow)]);
        break(2.4, f3052a8b, `<b>Exception: Period incomplete or reversed</b>`, plain=`Exception: Period incomplete or reversed`);
        simple(2.5, 29ce6f14, `The system checks that both days are in the current calendar year.`, plain=`The system checks that both days are in the current calendar year.`);
        break(2.6, b7a1d803, `<b>Exception: Period not within the current year</b>`, plain=`Exception: Period not within the current year`);
        simple(2.7, c47a1e90, `The system checks that the period does not overlap with any PENDING or 
    APPROVED vacation request of the employee.`, plain=`The system checks that the period does not overlap with any PENDING or APPROVED vacation request of the employee.`, markups=[(59,78,Changed,yellow)]);
        break(2.8, 6bd0359f, `<b>Exception: Period overlaps with another request</b>`, plain=`Exception: Period overlaps with another request`);
    }
    subsequence(3, 4f6d2e91, `<h2>
      <b>Calculate leave days</b>
    </h2>`, plain=`Calculate leave days`, deco=Co) {
        while(3.1, a8e03c57, `For every day from the first to the last day, the system checks...`, plain=`For every day from the first to the last day, the system checks...`, barWidth=22) {
            ifElse(3.1.1, 1d94b6f0, `Is the day a work day, i.e. neither a Saturday, nor a Sunday nor a public 
    holiday in the federal state of the employee's working location?`, plain=`Is the day a work day, i.e. neither a Saturday, nor a Sunday nor a public holiday in the federal state of the employee's working location?`, ifRatio=28.62%) {
                text(`<div>
      <i><font size="3">Note:</font></i>
    </div>
    <div>
      <i><font size="3">The federal state matters: Corpus Christi is a public 
      holiday in Bavaria, but not in Berlin.</font></i>
    </div>`, plain=`Note:
The federal state matters: Corpus Christi is a public holiday in Bavaria, but not in Berlin.`)
                if_branch(`not a work day`, plain=`not a work day`) {
                    simple(3.1.1.1, c5370e8a, `The system does not count the day.`, plain=`The system does not count the day.`);
                }
                else_branch(`work day`, plain=`work day`) {
                    simple(3.1.2.1, 72fa1b4d, `The system counts the day as a leave day needed.`, plain=`The system counts the day as a leave day needed.`);
                }
            }
        }
        simple(3.2, e90c58a3, `The system shows the counted days as leave days needed and checks if the 
    employee's remaining leave days are sufficient for the requested vacation 
    period.`, plain=`The system shows the counted days as leave days needed and checks if the employee's remaining leave days are sufficient for the requested vacation period.`);
        break(3.3, 3b6d97e2, `<b>Exception: Period contains no work day</b>`, plain=`Exception: Period contains no work day`);
        break(3.4, e99aa29f, `<b>Exception: Remaining leave days exceeded</b>`, plain=`Exception: Remaining leave days exceeded`);
        simple(3.5, fb2bed46, `The system enables the <b>Request</b> button.`, plain=`The system enables the Request button.`);
    }
    subsequence(4, a3d8f512, `<h2>
      <b>Submit request</b>
    </h2>`, plain=`Submit request`, deco=Co) {
        simple(4.1, 5c1e90b7, `The employee presses the <b>Request</b> button.`, plain=`The employee presses the Request button.`);
        simple(4.2, e26b4d38, `The system creates a PENDING vacation request of the employee for the 
    entered period.`, plain=`The system creates a PENDING vacation request of the employee for the entered period.`);
        simple(4.3, 1fa97c64, `The system sends an e-mail to the employee's supervisor about the pending 
    request.`, plain=`The system sends an e-mail to the employee's supervisor about the pending request.`);
        simple(4.4, b80d2e95, `The system confirms to the employee that the request was submitted.`, plain=`The system confirms to the employee that the request was submitted.`);
    }
    catchArea {
        catch(2.4, `<b>Exception: Period incomplete or reversed</b>`, plain=`Exception: Period incomplete or reversed`, headingWidth=12) {
            coCatch(2.6, `<b>Exception: Period not within the current year</b>`, plain=`Exception: Period not within the current year`);
            coCatch(2.8, `<b>Exception: Period overlaps with another request</b>`, plain=`Exception: Period overlaps with another request`);
            coCatch(3.3, `<b>Exception: Period contains no work day</b>`, plain=`Exception: Period contains no work day`);
            coCatch(3.4, `<b>Exception: Remaining leave days exceeded</b>`, plain=`Exception: Remaining leave days exceeded`);
            simple(2.4.1, 17d3c9b5, `The system shows an appropriate hint. The <b>Request</b> button stays 
    disabled.`, plain=`The system shows an appropriate hint. The Request button stays disabled.`);
        }
    }
}

outro(`<h2>
      Business rules
    </h2>
    An employee's annual leave days include any remaining leave days carried 
    over from the previous year.

    <h2>
      Wire frame
    </h2>`, plain=`Business rules
An employee's annual leave days include any remaining leave days carried over from the previous year.
Wire frame`) {
    image(scale=93.32%, type=png) { [base64:] }
    text(`<h2>
      Domain model
    </h2>`, plain=`Domain model`)
    image(scale=92.51%, type=plantuml) { `@startuml
' Layout hints, effective with Graphviz only (ELK ignores them)
left to right direction
skinparam linetype polyline
class Employee {
  name
  email
  annualLeaveDays
}
class WorkingLocation {
  name
}
class FederalState {
  name
}
class PublicHoliday {
  date
  name
}
class VacationRequest {
  firstDay
  lastDay
  leaveDays
  state
}
enum RequestState {
  PENDING
  APPROVED
  REJECTED
}
Employee "*" --> "1" WorkingLocation : works at
Employee "*" --> "0..1" Employee : Supervisor
Employee "1" --> "*" VacationRequest : requests
VacationRequest --> RequestState
WorkingLocation "*" --> "1" FederalState : lies in
FederalState "1" --> "*" PublicHoliday : observes
@enduml` }
    text(`<h2>
      Open issues
    </h2>
    <div>
      Aspects which this specification deliberately leaves open for the next 
      iterations.
    </div>`, plain=`Open issues
Aspects which this specification deliberately leaves open for the next iterations.`)
    table(width=100%, cols=[78%, 11%, 11%]) {
        row { cell(`<b>Issue</b>`, plain=`Issue`) | cell(`<b>Prio</b>`, plain=`Prio`) | cell(`<b>Status</b>`, plain=`Status`) }
        row { cell(`What about part-time employees and how to count their leave days?`, plain=`What about part-time employees and how to count their leave days?`) | cell(`1`, plain=`1`) | cell(`open`, plain=`open`) }
        row { cell(`Should we support half day vacations?`, plain=`Should we support half day vacations?`) | cell(`2`, plain=`2`) | cell(`open`, plain=`open`) }
        row { cell(`What about local public holidays and company holidays like December 24?`, plain=`What about local public holidays and company holidays like December 24?`) | cell(`3`, plain=`3`) | cell(`open`, plain=`open`) }
        row { cell(`Periods limited to the current calendar year is too uncomfortable.`, plain=`Periods limited to the current calendar year is too uncomfortable.`) | cell(`1`, plain=`1`) | cell(`open`, plain=`open`) }
    }
}
